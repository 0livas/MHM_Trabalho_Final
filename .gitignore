# Somente código, entradas, baselines, resultados e instruções ficam no repositório.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/src/
!/data/

/data/*
!/data/input/
!/data/output/
!/data/baselines/

.vscode/
.idea/
__pycache__/
*.py[cod]
.venv/
venv/
*.log
*.err
*.tmp
*.checkpoint.json

!/tests/
# Final comparison raw/generated artifacts
data/output/final_comparison/runs/
data/output/final_comparison/outcomes/
data/output/final_comparison/history/
data/output/final_comparison/empirical_reference_fronts/
data/output/final_comparison/checks.json
data/output/final_comparison/checks_amendment.json
data/output/final_comparison/execution_failure.json
data/output/final_comparison/summarize_blocked.py

# AGE-MOEA: preserve bulky pilot evidence and local archive outside Git.
!/requirements-age-repro.txt
/data/output/age/piloto/runs/
/data/output/age/piloto/references.json
/data/output/age/artifacts/

# Banco local de calibração; CSV, protocolo e resultados JSON ficam versionáveis.
/data/output/hyperparameters_tuning/**/study.sqlite3*
/data/output/hyperparameters_tuning/**/study.lock

# Documentação única do projeto; relatórios Markdown gerados ficam locais.
*.md
!/README.md
